---
import PageLayout from './PageLayout.astro';
import CvCard from '../components/CvCard.astro';
import CvIcon from '../components/CvIcon.astro';
import CvNetwork from '../components/CvNetwork.astro';
import { cvDesign } from '../data/cv-design';
import { networkSectionStyle } from '../data/cv-network';
import type { CvContent } from '../data/cv';
import '../styles/cv.css';
interface Props { content: CvContent }
const { content } = Astro.props;
---
<PageLayout title={content.title} description={content.description} lang={content.lang} isCv>
  <CvNetwork />
  <header class="cv-hero cv-network-section" data-network-section="hero" style={networkSectionStyle('hero')}>
    {cvDesign.hero.backgroundSrc && <img class="cv-hero-background" src={cvDesign.hero.backgroundSrc} alt="" aria-hidden="true" fetchpriority="high" />}
    <div class="cv-container hero-inner">
      <div class="hero-copy">
        <p class="cv-eyebrow">{content.draft}</p>
        <h1>{content.name}</h1>
      </div>
      <div class="cv-portrait">
        {content.portrait ? (
          <img src={content.portrait.src} alt={content.portrait.alt} width="480" height="560" fetchpriority="high" />
        ) : (
          <>
            <img class="portrait-placeholder" src="/images/cv-person-placeholder.png" alt="" width="320" height="380" />
            <span class="portrait-label">{content.portraitLabel}</span>
          </>
        )}
      </div>
    </div>
  </header>

  <section class="cv-section cv-profile cv-network-section" data-network-section="profile" style={networkSectionStyle('profile')} aria-labelledby="profile-heading">
    <div class="cv-container">
      <h2 id="profile-heading">{content.profile.heading}</h2>
      <div class="glass profile-card"><p>{content.profile.text}</p></div>
    </div>
  </section>

  {[{ id: 'strengths' as const, ...content.strengths }, { id: 'skills' as const, ...content.skills }].map(section => (
    <section class={`cv-section cv-${section.id} cv-network-section`} data-network-section={section.id} style={networkSectionStyle(section.id)} aria-labelledby={`${section.id}-heading`}>
      <div class="cv-container">
        <h2 id={`${section.id}-heading`}>{section.heading}</h2>
        <div class="cv-cards" data-card-stack>
          {section.cards.map(card => <CvCard card={card} />)}
        </div>
      </div>
    </section>
  ))}

  <section class="cv-section cv-history cv-network-section" data-network-section="history" style={networkSectionStyle('history')} aria-labelledby="history-heading">
    <div class="cv-container">
      <h2 id="history-heading">{content.history.heading}</h2>
      <div class="glass history-card">
        <table>
          <caption><span><CvIcon name="briefcase" /><span class="history-title">{content.history.tableTitle}</span></span></caption>
          <thead><tr>{content.history.columns.map(column => <th scope="col">{column}</th>)}</tr></thead>
          <tbody>{content.history.rows.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <div class="cv-cards" data-card-stack>
        {content.history.cards.map(card => <CvCard card={card} />)}
      </div>
    </div>
  </section>
</PageLayout>

<script>
  import { alignSectionText } from '../scripts/cv-section-spacing';
  alignSectionText();

  // Small progressive enhancement: pack uneven cards while keeping the DOM in
  // left/right reading order. Without JS, the same cards form a regular grid.
  for (const stack of document.querySelectorAll<HTMLElement>('[data-card-stack]')) {
    const cards = Array.from(stack.querySelectorAll<HTMLElement>('.cv-card'));
    const observer = new ResizeObserver(() => {
      const desktop = window.matchMedia('(min-width: 700px)').matches;
      stack.classList.toggle('is-packed', desktop);
      const nextRow = [1, 1];
      for (const [index, card] of cards.entries()) {
        const column = index % 2;
        const span = Math.ceil(card.getBoundingClientRect().height);
        // Leave a gap only between cards, never after the last card in a column.
        card.style.gridRow = desktop ? `${nextRow[column]} / span ${span}` : '';
        nextRow[column] += span + 24;
      }
    });
    for (const card of cards) observer.observe(card);
    observer.observe(stack);
  }
</script>
