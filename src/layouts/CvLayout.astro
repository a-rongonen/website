---
import PageLayout from './PageLayout.astro';
import CvSection from '../components/CvSection.astro';
import CvNetwork from '../components/CvNetwork.astro';
import { cvDesign } from '../data/cv-design';
import { networkSectionStyle, networkContentPalette, type NetworkSection } from '../data/cv-network';
import { visibleCvSections } from '../data/cv-sections';
import type { CvContent } from '../data/cv';
import '../styles/cv.css';
interface Props { content: CvContent }
const { content } = Astro.props;
const sections = visibleCvSections(content.sections);
const palettes: NetworkSection[] = ['hero', ...sections.map((_, index) => networkContentPalette(index))];
const firstSection = sections[0];
const scrollTarget = firstSection && `${firstSection.id}-${firstSection.heading.trim() ? 'heading' : 'section'}`;
---
<PageLayout title={content.title} description={content.description} lang={content.lang} isCv>
  <CvNetwork />
  <header class="cv-hero cv-network-section" data-network-section="hero" style={networkSectionStyle('hero', palettes, 0)}>
    {cvDesign.hero.backgroundSrc && <div class="cv-hero-background" aria-hidden="true" style={{ backgroundImage: `url(${JSON.stringify(cvDesign.hero.backgroundSrc)})` }} />}
    <div class="cv-container hero-inner">
      <div class="hero-copy">
        <p class="cv-eyebrow">{content.draft}</p>
        <h1>{content.name.trim().split(/\s+/).map((word, index) => <>{index > 0 && ' '}<span class="cv-name-word">{word}</span></>)}</h1>
      </div>
      <div class="cv-portrait">
        {content.portrait ? (
          <img src={content.portrait.src} alt={content.portrait.alt} width={content.portrait.width} height={content.portrait.height} fetchpriority="high" />
        ) : (
          <>
            <img class="portrait-placeholder" src="/images/cv-person-placeholder.png" alt="" width="320" height="380" />
            <span class="portrait-label">{content.portraitLabel}</span>
          </>
        )}
      </div>
    </div>
    {scrollTarget && <a class="cv-scroll-cue" href={`#${scrollTarget}`} aria-label={content.scrollPrompt}>
      <span class="cv-scroll-cue-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m6 7 6 6 6-6M6 13l6 6 6-6" />
        </svg>
      </span>
    </a>}
  </header>

  {sections.map((section, index) => <CvSection section={section} palettes={palettes} index={index + 1} />)}
</PageLayout>

<script>
  import '../scripts/cv-enhancements';
</script>
