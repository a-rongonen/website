---
import PageLayout from '../layouts/PageLayout.astro';
import CvNetwork from '../components/CvNetwork.astro';
import CvSection from '../components/CvSection.astro';
import PortfolioMedia from '../components/PortfolioMedia.astro';
import PortfolioCases from '../components/PortfolioCases.astro';
import PortfolioFeature from '../components/PortfolioFeature.astro';
import { cvEnglish } from '../data/cv';
import { visibleCvSections } from '../data/cv-sections';
import { networkContentPalette, networkSectionStyle, type NetworkSection } from '../data/cv-network';
import { portfolio, portfolioDesign } from '../data/portfolio';
import '../styles/cv.css';
import '../styles/portfolio.css';

// The first three CV sections (hero, Profile, Skills) are replaced here.
// Keep all remaining entries, including the reusable empty final entry.
const sections = visibleCvSections(cvEnglish.sections.slice(2));
const palettes: NetworkSection[] = Array.from({ length: 4 + sections.length }, (_, index) => networkContentPalette(index));
---

<PageLayout title={`${portfolio.name} Portfolio`} description={`${portfolio.name} portfolio, featuring game design cases from Panic Lane.`} isPortfolio>
  <CvNetwork />
  <header class="portfolio-hero cv-network-section" data-network-section={palettes[0]}
    style={`${networkSectionStyle(palettes[0], palettes, 0)} --portfolio-title-color: ${portfolioDesign.titleColor}; --portfolio-title-scale: ${portfolioDesign.titleScale};`}>
    <div class="cv-container portfolio-hero-inner">
      <h1 class="portfolio-title">
        <span class="portfolio-owner">{portfolio.name.split(' ').map((word, index) => <>{index > 0 && ' '}<span>{word}</span></>)}</span>
        <span class="portfolio-title-word">PORTFOLIO</span>
      </h1>
      <PortfolioMedia {...portfolio.heroVideo} controls={false} eager />
    </div>
  </header>

  <section class="cv-section cv-network-section portfolio-unique portfolio-background" data-network-section={palettes[1]}
    style={networkSectionStyle(palettes[1], palettes, 1)} aria-labelledby="background-heading">
    <div class="cv-container">
      <h1 class="portfolio-section-title" id="background-heading">{portfolio.background.heading}</h1>
      <PortfolioFeature media={portfolio.background.video} text={portfolio.background.text} />
    </div>
  </section>

  <section class="cv-section cv-network-section portfolio-unique portfolio-learning" data-network-section={palettes[2]}
    style={networkSectionStyle(palettes[2], palettes, 2)} aria-labelledby="learning-heading">
    <div class="cv-container">
      <h1 class="portfolio-section-title" id="learning-heading">{portfolio.learning.heading.map(line => <span>{line}</span>)}</h1>
      <PortfolioFeature media={portfolio.learning.video} text={portfolio.learning.text} controlsOnInteraction />
    </div>
  </section>

  <section class="cv-section cv-network-section portfolio-unique portfolio-cases-section" data-network-section={palettes[3]}
    style={networkSectionStyle(palettes[3], palettes, 3)} aria-labelledby="cases-heading">
    <div class="cv-container">
      <h1 class="portfolio-section-title" id="cases-heading"><span>3 Game Design Cases</span></h1>
      <PortfolioCases cases={portfolio.cases} />
    </div>
  </section>

  {sections.map((section, index) => <CvSection section={section} palettes={palettes} index={index + 4} />)}
</PageLayout>

<script>
  import '../scripts/cv-enhancements';
</script>
