---
import CvIcon from './CvIcon.astro';
import InlineText from './InlineText.astro';
import type { CvCard } from '../data/cv';
interface Props { card: CvCard }
const { card } = Astro.props;
---
<article class="cv-card glass">
  <h3><CvIcon name={card.icon} /><span><InlineText text={card.title} /></span></h3>
  {card.text.split('\n\n').map(paragraph => <p><InlineText text={paragraph} /></p>)}
</article>
