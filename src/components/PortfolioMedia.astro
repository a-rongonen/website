---
import type { PortfolioMedia } from '../data/portfolio';
import PortfolioMediaAsset from './PortfolioMediaAsset.astro';
interface Props extends PortfolioMedia {
  controls?: boolean;
  controlsOnInteraction?: boolean;
  eager?: boolean;
}
const { src, label, width, height, kind = 'video', eager = false } = Astro.props;
// Reserve the native frame before the browser has downloaded any media.
const ratio = width && height ? `${width} / ${height}` : '16 / 9';
---
<div class:list={['portfolio-media', { 'portfolio-media-placeholder': !src }]}
  data-portfolio-media={src ? '' : undefined} data-media-eager={eager || undefined}
  data-media-kind={kind}
  style={`aspect-ratio: ${ratio};`}>
  {src ? eager ? (
    <PortfolioMediaAsset {...Astro.props} />
  ) : (
    <>
      <template data-media-template><PortfolioMediaAsset {...Astro.props} /></template>
      <noscript><PortfolioMediaAsset {...Astro.props} /></noscript>
    </>
  ) : (
    <div class="portfolio-media-message">
      <svg aria-hidden="true" viewBox="0 0 48 48" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.25">
        <rect x="3" y="9" width="42" height="30" rx="5" />
        <path d="m20 17 12 7-12 7z" />
      </svg>
      <span>{label}</span>
    </div>
  )}
</div>

<script>
  import '../scripts/portfolio-media';
</script>
