---
import type { PortfolioSlide } from '../data/portfolio';
import PortfolioFeature from './PortfolioFeature.astro';
import '../styles/portfolio-carousel.css';

interface Props {
  slides: PortfolioSlide[];
  labelledBy: string;
}
const { slides, labelledBy } = Astro.props;
---
<portfolio-carousel role="region" aria-roledescription="carousel" aria-labelledby={labelledBy} data-carousel-selected="1">
  <div class="portfolio-carousel-viewport" data-carousel-viewport role="group" aria-label="Small Wins cards">
    <div class="portfolio-carousel-track" data-carousel-track>
      {slides.map((slide, index) => (
        <div data-carousel-panel data-carousel-page={index + 1} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${slides.length}`}>
          <PortfolioFeature media={slide.media} text={slide.text} controlsOnInteraction />
        </div>
      ))}
    </div>
  </div>
  <output class="portfolio-carousel-sr-only" data-carousel-status aria-live="polite" aria-atomic="true"></output>
  <button class="portfolio-carousel-sr-only" type="button" tabindex="-1" data-carousel-accessible-previous hidden>Previous small win</button>
  <button class="portfolio-carousel-sr-only" type="button" tabindex="-1" data-carousel-accessible-next hidden>Next small win</button>
</portfolio-carousel>

<script>
  import '../scripts/portfolio-carousel';
</script>
